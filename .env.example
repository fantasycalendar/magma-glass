APP_NAME="Magma Glass"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_PORT=9982
APP_URL=http://localhost:${APP_PORT:-9982}

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_DATABASE is auto-created as database/database.sqlite

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ===========================================
# Magma Glass Configuration
# ===========================================

# GitHub repository containing your Obsidian vault (SSH URL)
GITHUB_REPO=

# Branch to watch for webhook updates
GITHUB_WATCH_BRANCHES=master

# Subdirectory within the repo that contains your vault (blank if root)
GITHUB_REPO_SUBDIR=

# Path to the SSH deploy key (relative to storage/ or absolute)
GITHUB_DEPLOY_KEY_PATH=app/id_rsa

# Set to false to skip webhook signature verification (local dev only)
GITHUB_SIGNATURE_VERIFY=true

# Webhook secret configured in GitHub
GITHUB_WEBHOOK_SECRET=

# Article cache TTL in seconds (default: 3600 = 1 hour)
ARTICLE_CACHE_TTL=3600

# Default article to show on homepage (blank = auto-detect Home/Index/Start here)
DEFAULT_ARTICLE_PATH=

# Comma-separated list of folder names to exclude from the vault
IGNORED_PATHS=

# Storage driver and root for articles
ARTICLE_DRIVER=local
ARTICLE_ROOT=

# Trusted proxy IPs (comma-separated, or * for all)
# TRUSTED_PROXIES=*

# ===========================================
# Laravel Sail Configuration
# ===========================================

# Forward Redis port to host (for local tools like TablePlus)
FORWARD_REDIS_PORT=6379

# Vite dev server port
VITE_PORT=5173

# Xdebug mode (off, develop, debug, coverage)
SAIL_XDEBUG_MODE=off
